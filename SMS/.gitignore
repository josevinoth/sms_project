# Ignore all Excel, PowerPoint, and PDF files
*.xlsx
*.pptx
*.pdf


# Ignore everything in Requirements folder except Python files
Requirements/*
!Requirements/*.py

# Ignore compiled Python files and cache in migrations
/sms_app/migrations/*.pyc
/sms_app/migrations/**/__pycache__/

# Ignore media files but allow metadata
/media/*
!/media/metadata_example.txt

# Ignore IDE-related files
.idea/
# Do not ignore __init__.py files
# (No rule here to ignore __init__.py)
.idea/vcs.xml
